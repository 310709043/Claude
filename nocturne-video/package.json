{
  "name": "nocturne-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion intro/feature/user-flow video for the Nocturne (夜訊) prototype",
  "scripts": {
    "gen:ambient": "node scripts/gen-ambient.mjs",
    "studio": "remotion studio",
    "still": "remotion still src/index.ts Nocturne --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
